# heart-pilot 服务器环境变量
# 用法：cp .env.prod.example .env.prod && chmod 600 .env.prod

PUBLIC_HOST=101.201.208.223
# 对外端口：http://101.201.208.223:8081/
HTTP_PORT=8081

# ---- 共享中间件（密码与 deploy/server/.env 一致）----
PG_USER=heart_pilot
PG_PASSWORD=CHANGE_ME_pg
REDIS_PASSWORD=CHANGE_ME_redis
MINIO_ACCESS_KEY=lpminio
MINIO_SECRET_KEY=CHANGE_ME_minio
MINIO_BUCKET=heart-pilot

# ---- 应用 ----
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_admin
CORS_ALLOWED_ORIGINS=http://101.201.208.223:8081

# 大模型 Key（不填则 AI 相关功能降级，不影响启动）
DASHSCOPE_API_KEY=
SEARCH_API_KEY=
AMAP_MAPS_API_KEY=
PEXELS_API_KEY=
